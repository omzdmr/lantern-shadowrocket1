#!name=Lantern Free Probe v3
#!desc=Lantern Free config API'yi gerçek bir HTTP tetikleyici üzerinden sorgular ve sonucu doğrudan tarayıcıda gösterir. Localhost veya bildirim gerekmez.

[Script]
Lantern Free Probe v3 = type=http-request,pattern=^http:\/\/neverssl\.com\/lantern-probe(?:\?.*)?$,requires-body=false,timeout=30,engine=jsc,script-path=https://raw.githubusercontent.com/omzdmr/lantern-shadowrocket1/main/lantern_shadowrocket_probe_v3.js

[Rule]
DOMAIN,df.iantem.io,DIRECT
DOMAIN,neverssl.com,DIRECT
